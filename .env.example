APP_NAME="Laravel Notes API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Use sqlite for quick local setup, or switch to pgsql (see config/database.php)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Uncomment to use PostgreSQL instead:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=notes_api
# DB_USERNAME=postgres
# DB_PASSWORD=
